      <path d="M21.5 4.3 2.9 11.5c-1 .4-1 1.7.1 2l4.6 1.4 1.8 5.4c.3.8 1.3 1 1.9.4l2.5-2.4 4.7 3.5c.7.5 1.7.1 1.9-.7l3-14.3c.2-1-.8-1.9-1.8-1.5ZM9.7 14.3l8-5-6.6 6.1c-.2.2-.3.4-.4.7l-.3 2.2-.7-4Z" />
